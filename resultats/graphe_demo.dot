graph G {
  node [style=filled];
  0 [fillcolor="lightgreen", label="0 (c2)"];
  1 [fillcolor="lightblue", label="1 (c0)"];
  2 [fillcolor="lightcoral", label="2 (c1)"];
  3 [fillcolor="lightcoral", label="3 (c1)"];
  4 [fillcolor="lightblue", label="4 (c0)"];
  0 -- 1;
  0 -- 2;
  1 -- 2;
  1 -- 3;
  2 -- 4;
  3 -- 4;
}
